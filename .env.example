# Copier en .env (non versionné) ou exporter dans le terminal. Ne jamais commiter de vrai secret.

# URL de connexion PostgreSQL. En local avec docker-compose.yml :
DATABASE_URL=postgres://spacejo:spacejo@localhost:5433/spacejo
# En production (Render → Environment), l'URL du pooler Supabase en mode session (port 5432),
# avec TLS, par exemple : postgres://USER:MOT_DE_PASSE@HOTE/spacejo?sslmode=require

# Adresse publique du site, sans « / » final (aperçus Open Graph des liens partagés), lue à la construction
# de l'interface. À définir aussi dans Render → Environment. Ce n'est pas un secret.
VITE_SITE_URL=https://spacejo.example

# Port du serveur. 3000 par défaut, attendu par le proxy de Vite (Render fournit le sien).
PORT=3000
# Dossier de l'interface construite, servie par le serveur. web/dist par défaut.
STATIC_DIR=web/dist
